# These resolve tools from the pinned Nix shell. Keeping the set explicit makes
# the remaining step toward fully hermetic tool archives visible and reviewable.
system_cxx_toolchain(
    name = "cxx",
    archiver = read_root_config("nucleus", "ar"),
    compiler = read_root_config("nucleus", "cc"),
    compiler_type = "clang",
    cxx_compiler = read_root_config("nucleus", "cxx"),
    linker = read_root_config("nucleus", "cxx"),
    visibility = ["PUBLIC"],
)

