(define IsCoprod ('a 'b 't)
  (exists inl (-> 'a 't)
    (exists inr (-> 'b 't)
      (ty.forall 'c
        (forall f (-> 'a 'c)
          (forall g (-> 'b 'c)
            (exists h (-> 't 'c)
              (and
                (and
                  (forall x 'a (= (h (inl x)) (f x)))
                  (forall y 'b (= (h (inr y)) (g y))))
                (forall k (-> 't 'c)
                  (imp
                    (and
                      (forall x 'a (= (k (inl x)) (f x)))
                      (forall y 'b (= (k (inr y)) (g y))))
                    (= k h)))))))))))

; The predicate used to carve naturals out of an infinite carrier.  The zero
; and successor candidates remain explicit arguments, so this definition is
; reusable with any injective endomap and chosen point.
(define NatMember ('a)
  (-> 'a (-> (-> 'a 'a) (-> 'a bool)))
  (lambda zero 'a
    (lambda succ (-> 'a 'a)
      (lambda n 'a
        (forall P (-> 'a bool)
          (imp
            (and
              (P zero)
              (forall k 'a (imp (P k) (P (succ k)))))
            (P n)))))))

; The graph predicate for primitive recursion.  It is deliberately generic in
; both the natural carrier and codomain: userspace specializes it to `nat`,
; proves existence and uniqueness from `nat.induction`, and only then selects
; `nat.rec` with Hilbert choice.  This schema itself asserts nothing.
(define NatRecSpec ('a 'c)
  (-> 'a
    (-> (-> 'a 'a)
      (-> 'c
        (-> (-> 'a (-> 'c 'c))
          (-> (-> 'a 'c) bool)))))
  (lambda zero 'a
    (lambda succ (-> 'a 'a)
      (lambda base 'c
        (lambda step (-> 'a (-> 'c 'c))
          (lambda candidate (-> 'a 'c)
            (and
              (= (candidate zero) base)
              (forall n 'a
                (= (candidate (succ n))
                   (step n (candidate n)))))))))))

; The least recursion graph, represented impredicatively as the intersection
; of every binary predicate containing the base pair and closed under the
; recursion step.  Like NatRecSpec, this is only an open definition: the
; userspace derived layer must prove base, closure, totality, and functionality.
(define NatRecGraph ('a 'c)
  (-> 'a
    (-> (-> 'a 'a)
      (-> 'c
        (-> (-> 'a (-> 'c 'c))
          (-> 'a (-> 'c bool))))))
  (lambda zero 'a
    (lambda succ (-> 'a 'a)
      (lambda base 'c
        (lambda step (-> 'a (-> 'c 'c))
          (lambda n 'a
            (lambda y 'c
              (forall R (-> 'a (-> 'c bool))
                (imp
                  (and
                    ((R zero) base)
                    (forall k 'a
                      (forall z 'c
                        (imp
                          ((R k) z)
                          ((R (succ k)) ((step k) z))))))
                  ((R n) y))))))))))
