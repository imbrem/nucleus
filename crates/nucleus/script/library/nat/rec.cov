; The recursion equations for a candidate map. A future theory declaration
; can state unique existence and concrete.cov can select the unique witness.
(import logic)

(define NatRecSpec ('n 'a)
  (-> 'n
    (-> (-> 'n 'n)
      (-> 'a
        (-> (-> 'n (-> 'a 'a))
          (-> (-> 'n 'a) bool)))))
  (lambda zero 'n
    (lambda succ (-> 'n 'n)
      (lambda base 'a
        (lambda step (-> 'n (-> 'a 'a))
          (lambda candidate (-> 'n 'a)
            ((logic.and
              (= (candidate zero) base))
              (forall n 'n
                (= (candidate (succ n))
                   ((step n) (candidate n)))))))))))
