package covalence:hol-proof-guest@0.5.0;

/// A bounded, non-authoritative recipe builder supplied to an untrusted proof guest.
///
/// Every resource below is an opaque handle to an append-only recipe node. It is not a
/// database integer ID, a checked theorem, or logical authority. The host binds every node to
/// exactly one plan, rejects cross-plan resources and forward references, and replays the
/// finished plan through one fresh Nucleus proof session.
///
/// Replay is isolated at the connection boundary: the host creates a fresh, otherwise
/// unreachable HOL connection for exactly one sealed plan. A guest failure, structural
/// rejection, policy denial, or Nucleus error discards that whole connection. Only a completely
/// successful replay may return the connection to the caller for optional serialization and
/// signing.
///
/// This contract exposes schematic binding, first-class conversions, immutable contexts, and the
/// first rules for assumptions and equality composition. Extending it with another HOL rule
/// changes the contract identity and requires an explicit host policy operation.
interface host {
  enum append-error {
    invalid-resource,
    invalid-dependency,
    resource-limit,
    sealed,
  }

  resource type-node;
  resource term-node;
  resource context-node;
  resource conversion-node;
  resource theorem-node;
  resource namespace-node;
  resource term-instantiation-map-node;
  resource type-instantiation-map-node;

  resource proof-plan {
    bool-type: func() -> result<type-node, append-error>;
    free-type: func(symbol: s64) -> result<type-node, append-error>;
    bound-term: func(index: u32, ty: borrow<type-node>) -> result<term-node, append-error>;
    free-term: func(symbol: s64, ty: borrow<type-node>) -> result<term-node, append-error>;
    lambda: func(
      parameter-type: borrow<type-node>,
      body: borrow<term-node>,
    ) -> result<term-node, append-error>;
    bool-term: func(value: bool) -> result<term-node, append-error>;
    application: func(
      function: borrow<term-node>,
      argument: borrow<term-node>,
    ) -> result<term-node, append-error>;
    epsilon: func(predicate: borrow<term-node>) -> result<term-node, append-error>;
    empty-context: func() -> result<context-node, append-error>;
    extend-context: func(
      base: borrow<context-node>,
      member: borrow<term-node>,
    ) -> result<context-node, append-error>;

    prove-hypothesis: func(
      context: borrow<context-node>,
      term: borrow<term-node>,
    ) -> result<theorem-node, append-error>;
    prove-truth: func(
      context: borrow<context-node>,
    ) -> result<theorem-node, append-error>;
    prove-reflexivity: func(
      context: borrow<context-node>,
      term: borrow<term-node>,
    ) -> result<theorem-node, append-error>;
    prove-deduction-antisymmetry: func(
      first: borrow<theorem-node>,
      second: borrow<theorem-node>,
    ) -> result<theorem-node, append-error>;
    prove-equality-modus-ponens: func(
      equality: borrow<theorem-node>,
      premise: borrow<theorem-node>,
    ) -> result<theorem-node, append-error>;
    prove-equality-substitution: func(
      equality: borrow<theorem-node>,
      predicate: borrow<term-node>,
      premise: borrow<theorem-node>,
    ) -> result<theorem-node, append-error>;

    conversion-reflexivity: func(
      term: borrow<term-node>,
    ) -> result<conversion-node, append-error>;
    conversion-symmetry: func(
      conversion: borrow<conversion-node>,
    ) -> result<conversion-node, append-error>;
    conversion-transitivity: func(
      first: borrow<conversion-node>,
      second: borrow<conversion-node>,
    ) -> result<conversion-node, append-error>;
    conversion-application: func(
      function: borrow<conversion-node>,
      argument: borrow<conversion-node>,
    ) -> result<conversion-node, append-error>;
    conversion-lambda: func(
      parameter-type: borrow<type-node>,
      body: borrow<conversion-node>,
    ) -> result<conversion-node, append-error>;
    conversion-beta: func(
      abstraction: borrow<term-node>,
      argument: borrow<term-node>,
    ) -> result<conversion-node, append-error>;
    conversion-eta: func(
      function: borrow<term-node>,
    ) -> result<conversion-node, append-error>;
    conversion-epsilon: func(
      predicate: borrow<conversion-node>,
    ) -> result<conversion-node, append-error>;
    prove-conversion-equality: func(
      context: borrow<context-node>,
      conversion: borrow<conversion-node>,
    ) -> result<theorem-node, append-error>;
    convert-theorem: func(
      theorem: borrow<theorem-node>,
      conversion: borrow<conversion-node>,
    ) -> result<theorem-node, append-error>;

    empty-term-instantiation-map: func() -> result<term-instantiation-map-node, append-error>;
    extend-term-instantiation-map: func(
      base: borrow<term-instantiation-map-node>,
      variable: borrow<term-node>,
      replacement: borrow<term-node>,
    ) -> result<term-instantiation-map-node, append-error>;
    prove-term-instantiation: func(
      theorem: borrow<theorem-node>,
      instantiations: borrow<term-instantiation-map-node>,
    ) -> result<theorem-node, append-error>;

    empty-type-instantiation-map: func() -> result<type-instantiation-map-node, append-error>;
    extend-type-instantiation-map: func(
      base: borrow<type-instantiation-map-node>,
      variable: borrow<type-node>,
      replacement: borrow<type-node>,
    ) -> result<type-instantiation-map-node, append-error>;
    prove-type-instantiation: func(
      theorem: borrow<theorem-node>,
      instantiations: borrow<type-instantiation-map-node>,
    ) -> result<theorem-node, append-error>;

    prove-abstraction: func(
      theorem: borrow<theorem-node>,
      variable: borrow<term-node>,
    ) -> result<theorem-node, append-error>;

    persist-theorem: func(theorem: borrow<theorem-node>) -> result<_, append-error>;
    root-child-namespace: func(name: option<string>) -> result<namespace-node, append-error>;

    /// Requests export of the checked theorem's conclusion after replay proves it. The theorem
    /// must already have appeared in `persist-theorem`.
    export-theorem-conclusion: func(
      namespace: borrow<namespace-node>,
      export-id: s64,
      theorem: borrow<theorem-node>,
      name: option<string>,
    ) -> result<_, append-error>;

    export-context: func(
      namespace: borrow<namespace-node>,
      export-id: s64,
      context: borrow<context-node>,
      name: option<string>,
    ) -> result<_, append-error>;
  }
}

/// The tiny surface implemented by an untrusted proof component.
interface guest {
  use host.{proof-plan, namespace-node};

  enum guest-error {
    aborted,
  }

  /// Appends a recipe to a host-created plan. Success asserts no theorem: after return, the host
  /// seals and replays the plan through Nucleus and independently decides whether to sign the
  /// resulting database. No signing key or general signing operation is available to the guest.
  /// Returns the one exported namespace which the host should name in the signed artifact.
  build: func(plan: borrow<proof-plan>) -> result<namespace-node, guest-error>;
}

world hol-proof-guest {
  import host;
  export guest;
}
