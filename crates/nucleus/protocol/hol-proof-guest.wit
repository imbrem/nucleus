package covalence:hol-proof-guest@0.1.0;

/// A bounded, non-authoritative recipe builder supplied to an untrusted proof guest.
///
/// Every resource below is an opaque handle to an append-only recipe node. It is not a
/// database integer ID, a checked theorem, or logical authority. The host binds every node to
/// exactly one plan, rejects cross-plan resources and forward references, and replays the
/// finished plan through one fresh Nucleus proof session.
///
/// Replay is also isolated at the connection boundary: the host creates a fresh, otherwise
/// unreachable HOL connection for exactly one sealed plan. A guest failure, structural
/// rejection, policy denial, or Nucleus error discards that whole connection. Only a completely
/// successful replay may return the connection to the caller for optional serialization and
/// signing. Dropping a guest handle does not delete an already appended node.
///
/// This first contract is intentionally just large enough for the closed-beta demo. Extending it
/// with another HOL rule changes the contract identity and requires an explicit host policy
/// operation.
interface host {
  /// Failure to append a structurally valid recipe node.
  enum append-error {
    /// A resource belongs to another plan or has already been invalidated.
    invalid-resource,
    /// A required earlier recipe node is absent or has the wrong sort.
    invalid-dependency,
    /// A documented plan, name, or node bound was exceeded.
    resource-limit,
    /// The host has sealed the plan against further appends.
    sealed,
  }

  /// Opaque recipe node for an admitted HOL type.
  resource type-node;

  /// Opaque recipe node for an admitted HOL term.
  resource term-node;

  /// Opaque recipe node for an immutable assumption context.
  resource context-node;

  /// Opaque recipe node for a theorem which exists only if checked replay succeeds.
  resource theorem-node;

  /// Opaque recipe node for a namespace requested during replay.
  resource namespace-node;

  /// One host-created append-only plan.
  ///
  /// There is deliberately no constructor: the host chooses the `Connection<P>` policy and all
  /// resource limits before invoking a guest. Replay performs the authoritative `InsertType`,
  /// `InsertTerm`, `ProveBeta`, `PersistJudgement`, `DefineNamespace`, and
  /// `ExportNamespaceValue` checks. The guest cannot probe `Policy::allows`, because policies may
  /// be stateful or record access; an exact denial remains visible to the host replay result.
  resource proof-plan {
    /// Appends the primitive Boolean type.
    bool-type: func() -> result<type-node, append-error>;

    /// Appends one explicitly typed de Bruijn occurrence.
    bound-term: func(index: u32, ty: borrow<type-node>) -> result<term-node, append-error>;

    /// Appends one typed term abstraction.
    lambda: func(parameter-type: borrow<type-node>, body: borrow<term-node>) -> result<term-node, append-error>;

    /// Appends one primitive Boolean literal.
    bool-term: func(value: bool) -> result<term-node, append-error>;

    /// Appends the reserved empty assumption context.
    empty-context: func() -> result<context-node, append-error>;

    /// Appends the checked closed-beta rule. The result is still only a recipe node.
    prove-beta: func(
      context: borrow<context-node>,
      abstraction: borrow<term-node>,
      argument: borrow<term-node>,
    ) -> result<theorem-node, append-error>;

    /// Requests persistence of a theorem after successful checked replay.
    persist-theorem: func(theorem: borrow<theorem-node>) -> result<_, append-error>;

    /// Appends a named child of the reserved root namespace.
    root-child-namespace: func(name: option<string>) -> result<namespace-node, append-error>;

    /// Requests export of the checked theorem's conclusion after replay proves it.
    ///
    /// The same theorem node must already have appeared in `persist-theorem`; otherwise the host
    /// rejects this append with `invalid-dependency`. Consequently every exported theorem
    /// coordinate is backed by an exact persisted judgement row.
    export-theorem-conclusion: func(
      namespace: borrow<namespace-node>,
      export-id: s64,
      theorem: borrow<theorem-node>,
      name: option<string>,
    ) -> result<_, append-error>;

    /// Requests export of an assumption context after successful replay.
    export-context: func(
      namespace: borrow<namespace-node>,
      export-id: s64,
      context: borrow<context-node>,
      name: option<string>,
    ) -> result<_, append-error>;
  }
}

/// The tiny surface implemented by an untrusted proof component.
interface guest {
  use host.{proof-plan};

  enum guest-error {
    aborted,
  }

  /// Appends a recipe to a host-created plan.
  ///
  /// Returning success does not assert that the recipe is a proof. After this call returns, the
  /// host seals and replays the plan through Nucleus, then independently decides whether to
  /// serialize or sign the resulting database. No signing key or general signing operation is
  /// available to the guest.
  build: func(plan: borrow<proof-plan>) -> result<_, guest-error>;
}

world hol-proof-guest {
  import host;
  export guest;
}
