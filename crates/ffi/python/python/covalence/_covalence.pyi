    """The unchecked claim that two expressions denote the same bytes.

    Ordering is undefined, exactly as on `BlobExpr`; see its docstring.
    """

    lhs: BlobExpr
    rhs: BlobExpr
    def __init__(self, lhs: BlobExpr, rhs: BlobExpr, /) -> None: ...
    def decide(self) -> bool | None: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> NoReturn: ...
    def __le__(self, other: object, /) -> NoReturn: ...
    def __gt__(self, other: object, /) -> NoReturn: ...
    def __ge__(self, other: object, /) -> NoReturn: ...

class BlobFact:
    """A checked equality between blob expressions.

    No constructor: only the rules below, `CasFact.to_blob_fact`,
    `CasRangeFact.to_blob_fact` and `IndexCas.blob_fact` introduce one.
    Ordering is undefined, exactly as on `BlobExpr`; see its docstring.
    """

    prop: BlobEq
    @staticmethod
    def check(prop: BlobEq, /) -> BlobFact: ...
    @staticmethod
    def refl(blob: BlobExpr, /) -> BlobFact: ...
    def symm(self) -> BlobFact: ...
    def trans(self, next: BlobFact, /) -> BlobFact: ...
    def cat(self, tail: BlobFact, /) -> BlobFact: ...
    def slice(self, start: int, end: int | None = None, /) -> BlobFact: ...
    def erase(self) -> BlobFact: ...
    def to_range_fact(self) -> CasRangeFact: ...
    def __add__(self, tail: BlobFact, /) -> BlobFact: ...
    def __radd__(self, head: BlobFact, /) -> BlobFact: ...
    def __getitem__(self, key: slice, /) -> BlobFact: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> NoReturn: ...
    def __le__(self, other: object, /) -> NoReturn: ...
    def __gt__(self, other: object, /) -> NoReturn: ...
    def __ge__(self, other: object, /) -> NoReturn: ...

