    def integer(value: int, /) -> Cbor: ...
    @staticmethod
    def bytes(value: Buffer, /) -> Cbor: ...
    @staticmethod
    def text(value: str, /) -> Cbor: ...
    @staticmethod
    def simple(value: int, /) -> Cbor: ...
