"""Compiled primitives exposed through the public Covalence modules."""

# PyO3 does not emit stubs, so this file is maintained alongside
# `crates/ffi/python/src`. `tests/test_typing.py` checks both directions for
# drift between the declarations and the compiled module.
#
# Buffer intentionally accepts bytes, bytearray, memoryview, and other
# contiguous buffer exporters.

from collections.abc import Buffer, Iterable, Sequence
from typing import NoReturn

__version__: str

class Atom:
    """An immutable atomic S-expression value."""

    kind: str
    value: str | bytes
    @staticmethod
    def symbol(value: str, /) -> Atom: ...
    @staticmethod
    def string(value: str, /) -> Atom: ...
    @staticmethod
    def bytes(value: Buffer, /) -> Atom: ...
    @staticmethod
    def number(value: str, /) -> Atom: ...
    @staticmethod
    def keyword(value: str, /) -> Atom: ...
    @staticmethod
    def directive(value: str, /) -> Atom: ...
    def __repr__(self) -> str: ...

class Event:
    """An immutable structural S-expression event."""

    kind: str
    span: tuple[int, int]
    value: Atom | None
    @staticmethod
    def open(start: int, end: int, /) -> Event: ...
    @staticmethod
    def atom(atom: Atom, start: int, end: int, /) -> Event: ...
    @staticmethod
    def close(start: int, end: int, /) -> Event: ...
    def __repr__(self) -> str: ...

class SExpr:
    """An immutable S-expression carrying source positions."""

    kind: str
    atom_value: Atom | None
    items: tuple[SExpr, ...]
    span: tuple[int, int]
    open_span: tuple[int, int] | None
    close_span: tuple[int, int] | None
    @staticmethod
    def atom(atom: Atom, start: int = 0, end: int = 0) -> SExpr: ...
    @staticmethod
    def list(
        items: Sequence[SExpr],
        open: tuple[int, int] = (0, 0),
        close: tuple[int, int] = (0, 0),
    ) -> SExpr: ...
    def events(self) -> list[Event]: ...
    def erase(self) -> ErasedSExpr: ...
    def format(self, width: int = 80, indent: int = 2) -> str: ...
    def __repr__(self) -> str: ...

class ErasedSExpr:
    """An immutable S-expression without source positions."""

    kind: str
    atom_value: Atom | None
    items: tuple[ErasedSExpr, ...]
    @staticmethod
    def atom(atom: Atom, /) -> ErasedSExpr: ...
    @staticmethod
    def list(items: Sequence[ErasedSExpr], /) -> ErasedSExpr: ...
    def __repr__(self) -> str: ...

class Document:
    """An immutable sequence of top-level S-expressions."""

    expressions: tuple[SExpr, ...]
    @staticmethod
    def from_events(events: Sequence[Event], /) -> Document: ...
    def events(self) -> list[Event]: ...
    def erase(self) -> ErasedDocument: ...
    def format(self, width: int = 80, indent: int = 2) -> str: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

class ErasedDocument:
    """An immutable sequence of spanless S-expressions."""

    expressions: tuple[ErasedSExpr, ...]
    def __init__(self, expressions: Sequence[ErasedSExpr], /) -> None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

def sexpr_parse(source: str, /) -> Document: ...
def sexpr_parse_one(source: str, /) -> SExpr: ...
def sexpr_parse_events(source: str, /) -> list[Event]: ...

