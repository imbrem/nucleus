"""Compiled primitives exposed through the public Covalence modules."""

# PyO3 does not emit stubs, so this file is maintained alongside
# `crates/ffi/python/src`. `tests/test_typing.py` checks both directions for
# drift between the declarations and the compiled module.
#
# Buffer intentionally accepts bytes, bytearray, memoryview, and other
# contiguous buffer exporters.

from collections.abc import Buffer, Iterable, Sequence

__version__: str

class Cbor:
    """An immutable, structurally shared CBOR value."""

    kind: str
    value: (
        int
        | bytes
        | str
        | tuple[Cbor, ...]
        | tuple[int, Cbor]
        | tuple[tuple[Cbor, Cbor], ...]
    )
    __hash__: None

    def __init__(self, value: object, /) -> None: ...
    @staticmethod
    def from_python(value: object, /) -> Cbor: ...
    @staticmethod
    def integer(value: int, /) -> Cbor: ...
    @staticmethod
    def bytes(value: Buffer, /) -> Cbor: ...
    @staticmethod
    def text(value: str, /) -> Cbor: ...
    @staticmethod
    def simple(value: int, /) -> Cbor: ...
    @staticmethod
    def bool(value: bool, /) -> Cbor: ...
    @staticmethod
    def null() -> Cbor: ...
    @staticmethod
    def undefined() -> Cbor: ...
    @staticmethod
    def float16(bits: int, /) -> Cbor: ...
    @staticmethod
    def float32(bits: int, /) -> Cbor: ...
    @staticmethod
    def float64(bits: int, /) -> Cbor: ...
    @staticmethod
    def tag(tag: int, value: Cbor, /) -> Cbor: ...
    @staticmethod
    def array(values: Sequence[Cbor], /) -> Cbor: ...
    @staticmethod
    def map(entries: Sequence[tuple[Cbor, Cbor]], /) -> Cbor: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> bool: ...
    def __le__(self, other: object, /) -> bool: ...
    def __gt__(self, other: object, /) -> bool: ...
    def __ge__(self, other: object, /) -> bool: ...

class HolLink:
    """A content-addressed Ethane arena link."""

    format: str
    blake3: O256
    def __init__(self, address: O256, /) -> None: ...

class HolDefinition:
    """An immutable snapshot of one private Ethane row."""

    reference: int
    tag: str
    children: list[int]
    name: int | None
    value: bool | None
    source: int | None
    foreign: int | None
    equal: int | None
    classifier: int | None

class HolMeta:
    """An immutable snapshot of Ethane premise or conclusion metadata."""

    tag: str
    source: int
    reference: int | None
    classifier: int | None

class HolArena:
    """A mutable, unvalidated one-based dense Ethane arena."""

    definitions: list[HolDefinition]
    imports: list[None | HolArena | HolLink]
    axioms: list[str]
    context: list[int]
    assumptions: list[HolMeta]
    assertions: list[HolMeta]
    def __init__(self) -> None: ...
    @classmethod
    def from_cbor(cls, bytes: Buffer, /) -> HolArena: ...
    @classmethod
    def standard(cls) -> HolArena: ...
    @staticmethod
    def standard_roots() -> dict[str, int]: ...
    def to_cbor(self) -> bytes: ...
    def address(self) -> O256: ...
    def definition(self, reference: int, /) -> HolDefinition | None: ...
    def add_null_import(self) -> int: ...
    def add_literal_import(self, arena: HolArena, /) -> int: ...
    def add_link_import(self, link: HolLink, /) -> int: ...
    def add_axiom(self, name: str, /) -> None: ...
    def add_context(self, reference: int, /) -> None: ...
    def assume_valid(self, source: int, /) -> None: ...
    def assert_valid(self, source: int, /) -> None: ...
    def assume_wf(self, source: int, reference: int, classifier: int, /) -> None: ...
    def assert_wf(self, source: int, reference: int, classifier: int, /) -> None: ...
    def kind_star(self) -> int: ...
    def kind_arr(self, domain: int, codomain: int, /) -> int: ...
    def bool_ty(self) -> int: ...
    def ty_arr(self, domain: int, codomain: int, /) -> int: ...
    def ty_app(self, function: int, argument: int, /) -> int: ...
    def ty_lam(self, binder: int, body: int, /) -> int: ...
    def ty_fv(self, name: int, kind: int, /) -> int: ...
    def ty_exists(self, name: int, predicate: int, /) -> int: ...
    def model(self, name: int, predicate: int, /) -> int: ...
    def tm_fv(self, name: int, ty: int, /) -> int: ...
    def app(self, function: int, argument: int, /) -> int: ...
    def lam(self, binder: int, body: int, /) -> int: ...
    def bool(self, value: bool, /) -> int: ...
    def tm_eq(self, left: int, right: int, /) -> int: ...
    def eps(self, ty: int, predicate: int, /) -> int: ...
    def tm_ref(self, source: int, foreign: int, /) -> int: ...
    def ty_ref(self, source: int, foreign: int, /) -> int: ...
    def kind_ref(self, source: int, foreign: int, /) -> int: ...
    def __len__(self) -> int: ...

class HolSession:
    """A resolver and retryable in-memory content-addressed store."""

    def __init__(self, fuel: int = 256) -> None: ...
    def insert(self, bytes: Buffer, /) -> O256: ...
    def store(self, arena: HolArena, /) -> O256: ...
    def contains(self, address: O256, /) -> bool: ...
    def resolve_sort(self, arena: HolArena, reference: int, /) -> str: ...
    def check(self, arena: HolArena, /) -> HolKernel: ...

class HolKind:
    """An opaque kind handle owned by one checked kernel."""

    reference: int

class HolTy:
    """An opaque type handle owned by one checked kernel."""

    reference: int

class HolTm:
    """An opaque term handle owned by one checked kernel."""

    reference: int

class HolEquality:
    """A checked equality claim owned by one kernel."""

    left: int
    right: int

class HolValidity:
    """A checked imported-kernel validity conclusion."""

    source: int

class HolKernel:
    """A checked Ethane arena."""

    arena: HolArena
    def kind(self, reference: int, /) -> HolKind: ...
    def ty(self, reference: int, /) -> HolTy: ...
    def tm(self, reference: int, /) -> HolTm: ...
    def import_literal(self, arena: HolArena, /) -> int: ...
    def import_link(self, link: HolLink, /) -> int: ...
    def kind_ref(self, source: int, foreign: int, /) -> HolKind: ...
    def ty_ref(self, source: int, foreign: int, /) -> HolTy: ...
    def tm_ref(self, source: int, foreign: int, /) -> HolTm: ...
    def assume_valid(self, source: int, /) -> None: ...
    def assert_valid(self, source: int, /) -> HolValidity: ...
    def assume_wf(self, source: int, foreign: int, classifier: int, /) -> None: ...
    def assert_wf(self, source: int, foreign: int, classifier: int, /) -> None: ...
    def star(self) -> HolKind: ...
    def bool_ty(self) -> HolTy: ...
    def tm_fv(self, name: int, ty: HolTy, /) -> HolTm: ...
    def lam(self, binder: HolTm, body: HolTm, /) -> HolTm: ...
    def app(self, function: HolTm, argument: HolTm, /) -> HolTm: ...
    def eq(self, left: HolTm, right: HolTm, /) -> HolTm: ...
    def bool(self, value: bool, /) -> HolTm: ...
    def add_context(self, proposition: HolTm, /) -> None: ...
    def add_axiom(self, name: str, /) -> None: ...
    def assert_eq(self, left: HolTm, right: HolTm, /) -> HolEquality: ...
    def equality_symm(self, equality: HolEquality, /) -> HolEquality: ...
    def equality_trans(
        self, left: HolEquality, right: HolEquality, /
    ) -> HolEquality: ...
    def equality_app(
        self,
        left_app: HolTm,
        right_app: HolTm,
        function: HolEquality,
        argument: HolEquality,
        /,
    ) -> HolEquality: ...
    def __len__(self) -> int: ...

COV: ContextKey
COV_ROOT: O256
COV_ROOT_CTX_KEY: str

class InvalidLengthError(ValueError):
    """A value had the wrong number of bytes or encoded characters."""

class InvalidHexError(ValueError):
    """A hexadecimal string contained something that is not a hexadecimal digit."""

class InvalidBase64Error(ValueError):
    """A Base64 string was outside the alphabet, mispadded, or non-canonical."""

class LratError(ValueError):
    """A typed LRAT operation was rejected."""

class MetamathError(ValueError):
    """A Metamath database could not be parsed or validated."""

class Expression:
    """A typecode followed by a flat Metamath symbol sequence."""

    typecode: str
    body: list[str]
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...

class Assertion:
    """An inspectable Metamath axiom or theorem."""

    label: str
    conclusion: Expression
    hypothesis_labels: list[str]
    disjoint_pairs: list[tuple[str, str]]
    proof_encoding: str | None
    is_theorem: bool
    def __repr__(self) -> str: ...

class Database:
    """A parsed Metamath database."""

    statement_count: int
    assertion_count: int
    theorem_count: int
    @staticmethod
    def parse(source: str, /) -> Database: ...
    @staticmethod
    def load(path: str, /) -> Database: ...
    def validate(self) -> int: ...
    def symbols(self, kind: str | None = None, /) -> list[str]: ...
    def labels(self) -> list[str]: ...
    def assertion(self, label: str, /) -> Assertion | None: ...
    def assertions(self) -> list[Assertion]: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...

class CnfError(ValueError):
    """A conjunctive-normal-form value was malformed."""

class Literal:
    """A signed, nonzero propositional literal."""

    value: int
    variable: int

    def __init__(self, value: int, /) -> None: ...
    def __int__(self) -> int: ...
    def __neg__(self) -> Literal: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Literal, /) -> bool: ...
    def __le__(self, other: Literal, /) -> bool: ...
    def __gt__(self, other: Literal, /) -> bool: ...
    def __ge__(self, other: Literal, /) -> bool: ...

class Clause:
    """A disjunction of literals."""

    literals: list[int]

    def __init__(self, literals: Sequence[int], /) -> None: ...
    def __len__(self) -> int: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Clause, /) -> bool: ...
    def __le__(self, other: Clause, /) -> bool: ...
    def __gt__(self, other: Clause, /) -> bool: ...
    def __ge__(self, other: Clause, /) -> bool: ...

class Formula:
    """A conjunction of clauses."""

    clauses: list[Clause]
    max_variable: int

    def __init__(self, clauses: Sequence[Clause], /) -> None: ...
    def __len__(self) -> int: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Formula, /) -> bool: ...
    def __le__(self, other: Formula, /) -> bool: ...
    def __gt__(self, other: Formula, /) -> bool: ...
    def __ge__(self, other: Formula, /) -> bool: ...

class RatGroup:
    """One explicitly delimited RAT resolvent check."""

    opposing_clause_id: int
    resolvent_rup_hints: list[int]

    def __init__(
        self, opposing_clause_id: int, resolvent_rup_hints: Sequence[int], /
    ) -> None: ...
    def __repr__(self) -> str: ...

class Step:
    """One typed LRAT proof step."""

    kind: str
    id: int | None
    clause: Clause | None
    ids: list[int] | None
    ordered_hints: list[int] | None

    @staticmethod
    def rup(id: int, clause: Clause, ordered_hints: Sequence[int], /) -> Step: ...
    @staticmethod
    def rat(
        id: int,
        clause: Clause,
        pivot: Literal,
        prefix_rup_hints: Sequence[int],
        groups: Sequence[RatGroup],
        /,
    ) -> Step: ...
    @staticmethod
    def forget(ids: Sequence[int], /) -> Step: ...

class Kernel:
    """A parser-independent typed LRAT clause kernel."""

    def __init__(self, initial: Formula, /) -> None: ...
    @property
    def refuted(self) -> bool: ...
    @property
    def high_water(self) -> int: ...
    def clause(self, id: int, /) -> list[int] | None: ...
    def learn_rup(
        self, id: int, clause: Clause, ordered_hints: Sequence[int], /
    ) -> None: ...
    def learn_rat(
        self,
        id: int,
        clause: Clause,
        pivot: Literal,
        prefix_rup_hints: Sequence[int],
        groups: Sequence[RatGroup],
        /,
    ) -> None: ...
    def forget(self, ids: Sequence[int], /) -> None: ...
    def verify(
        self,
        proof: str | Buffer | Iterable[Step],
        /,
    ) -> None: ...

def parse_text(text: str, /) -> list[Step]: ...
def parse_binary(proof: Buffer, /) -> list[Step]: ...

class Obj:
    """A fixed-width Covalence identifier, of no particular namespace.

    The base of every namespace class, and not instantiable itself. Comparison
    stops at the namespace boundary: `==` between two namespaces is `False` and
    `<` raises `TypeError`, whatever the bytes are.
    """

    def hex(self) -> str: ...
    def __bytes__(self) -> bytes: ...
    def __len__(self) -> int: ...
    def __str__(self) -> str: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: Obj, /) -> bool: ...
    def __le__(self, other: Obj, /) -> bool: ...
    def __gt__(self, other: Obj, /) -> bool: ...
    def __ge__(self, other: Obj, /) -> bool: ...

class O256(Obj):
    """A standard Covalence 256-bit object."""

    BYTES: int

    def __init__(self, data: Buffer, /) -> None: ...
    @staticmethod
    def from_hex(text: str, /) -> O256: ...
    @staticmethod
    def from_base64(text: str, /) -> O256: ...
    @staticmethod
    def from_multihash(data: Buffer, /) -> O256: ...
    def to_multihash(self) -> bytes: ...
    @staticmethod
    def from_raw_cid(text: str, /) -> O256: ...
    def to_raw_cid(self) -> str: ...
    @staticmethod
    def hash(data: Buffer, /) -> O256: ...
    @staticmethod
    def keyed(key: O256, data: Buffer, /) -> O256: ...
    @staticmethod
    def derive_key(context: str, data: Buffer, /) -> O256: ...
    @staticmethod
    def with_context(key: ContextKey, data: Buffer, /) -> O256: ...
    @staticmethod
    def root() -> O256: ...
    def tag(self, data: Buffer, /) -> O256: ...

