class InvalidLengthError(ValueError):
    """A value had the wrong number of bytes or encoded characters."""

class InvalidHexError(ValueError):
    """A hexadecimal string contained something that is not a hexadecimal digit."""

class InvalidBase64Error(ValueError):
    """A Base64 string was outside the alphabet, mispadded, or non-canonical."""

class CasCheckError(ValueError):
    """A CAS assertion or proof failed validation."""

class CasDigestMismatchError(CasCheckError):
    """A whole-object CAS assertion carried the wrong content hash."""

class CasRangeError(CasCheckError):
    """A CAS range was not derivable from the facts at hand."""

class CasProofError(CasCheckError):
    """A CAS range proof was unusable."""

class BlobRuleError(CasCheckError):
    """A blob-equality rule did not apply."""

class CasLookupError(LookupError):
    """A CAS lookup failed."""

class CasNotFoundError(CasLookupError):
    """A CAS does not contain the requested address."""

class CasAddressMismatchError(CasLookupError):
    """A CAS returned a checked fact for another address."""

class LratError(ValueError):
    """A typed LRAT operation was rejected."""

