class BlobExpr:
    """An expression denoting a byte string.

    Deliberately no `__len__`: a length may be unknown, and `__len__` must
    return an `int`. `len_bytes` is the total accessor.

    The four ordering methods exist only because defining `__eq__` fills one
    comparison slot; they return `NotImplemented`, so `<` raises `TypeError`.
    Expressions are syntax and have no order to report.
    """

    len_bytes: int | None
    size: int
    @staticmethod
    def blake3(hash: O256, /) -> BlobExpr: ...
    @staticmethod
    def bytes(blob: Buffer, /) -> BlobExpr: ...
    @staticmethod
    def zero(length: int, /) -> BlobExpr: ...
    @staticmethod
    def cat(left: BlobExpr, right: BlobExpr, /) -> BlobExpr: ...
    @staticmethod
    def slice(blob: BlobExpr, start: int, end: int | None = None, /) -> BlobExpr: ...
    def eval(self) -> bytes | None: ...
    def __add__(self, other: BlobExpr, /) -> BlobExpr: ...
    def __radd__(self, other: BlobExpr, /) -> BlobExpr: ...
    def __getitem__(self, key: slice, /) -> BlobExpr: ...
    def __repr__(self) -> str: ...
    def __hash__(self) -> int: ...
    def __eq__(self, other: object, /) -> bool: ...
    def __ne__(self, other: object, /) -> bool: ...
    def __lt__(self, other: object, /) -> NoReturn: ...
    def __le__(self, other: object, /) -> NoReturn: ...
    def __gt__(self, other: object, /) -> NoReturn: ...
    def __ge__(self, other: object, /) -> NoReturn: ...

