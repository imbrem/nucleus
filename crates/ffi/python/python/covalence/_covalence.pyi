    def hash(data: Buffer, /) -> Sha1: ...
    def to_git(self) -> GitHash: ...

class GitHash(Obj):
    """A traditional Git SHA-1 object name."""

    BYTES: int

    def __init__(self, data: Buffer, /) -> None: ...
    @staticmethod
    def from_hex(text: str, /) -> GitHash: ...
    @staticmethod
    def from_base64(text: str, /) -> GitHash: ...
    @staticmethod
