{
  "lexicon": 1,
  "id": "io.github.imbrem.nucleus.classicalArenaV2",
  "defs": {
    "main": {
      "type": "object",
      "description": "A canonical Nucleus classical syntax snapshot.",
      "required": ["words", "roots"],
      "properties": {
        "words": {
          "type": "bytes",
          "description": "Packed words as concatenated big-endian u32 values.",
          "minLength": 16
        },
        "roots": {
          "type": "array",
          "items": {
            "type": "ref",
            "ref": "#root"
          }
        }
      }
    },
    "root": {
      "type": "object",
      "description": "A premise and conclusion root pair.",
      "required": ["premise", "conclusion"],
      "properties": {
        "premise": {
          "type": "bytes",
          "minLength": 4,
          "maxLength": 4
        },
        "conclusion": {
          "type": "bytes",
          "minLength": 4,
          "maxLength": 4
        }
      }
    }
  }
}
