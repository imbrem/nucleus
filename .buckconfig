[cells]
  nucleus = .
  root = .
  prelude = prelude
  toolchains = toolchains
  none = none

[cell_aliases]
  config = prelude
  ovr_config = prelude
  fbcode = none
  fbsource = none
  fbcode_macros = none
  buck = none

[external_cells]
  prelude = bundled

[parser]
  target_platform_detector_spec = target:nucleus//...->prelude//platforms:default \
    target:prelude//...->prelude//platforms:default \
    target:toolchains//...->prelude//platforms:default

[build]
  execution_platforms = prelude//platforms:default

[project]
  ignore = .direnv,.git,.pnpm-store,apps/docs/build,apps/docs/node_modules,lean-docs,lean/Nucleus/.lake,lean/Nucleus/docbuild/.lake,node_modules,packages/nucleus/component,packages/nucleus/dist,packages/nucleus/generated,packages/nucleus/node_modules,target,tools/glu/target
