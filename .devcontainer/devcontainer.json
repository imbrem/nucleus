{
  "name": "Nucleus",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/nix:1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "containerEnv": {
    "NUCLEUS_DEVCONTAINER": "1",
    "NUCLEUS_GITHUB_ACTIONS": "${localEnv:GITHUB_ACTIONS}"
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.devcontainer/bin:${containerEnv:PATH}"
  },
  "remoteUser": "vscode",
  "mounts": [
    "source=nucleus-node-modules,target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=nucleus-docs-node-modules,target=${containerWorkspaceFolder}/apps/docs/node_modules,type=volume",
    "source=nucleus-package-node-modules,target=${containerWorkspaceFolder}/packages/nucleus/node_modules,type=volume",
    "source=nucleus-pnpm-store,target=${containerWorkspaceFolder}/.pnpm-store,type=volume",
    "source=nucleus-buck-out,target=${containerWorkspaceFolder}/buck-out,type=volume",
    "source=nucleus-direnv,target=${containerWorkspaceFolder}/.direnv,type=volume",
    "source=nucleus-target,target=${containerWorkspaceFolder}/target,type=volume",
    "source=nucleus-glu-target,target=${containerWorkspaceFolder}/tools/glu/target,type=volume"
  ],
  "postCreateCommand": ".devcontainer/bin/post-create",
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "svelte.svelte-vscode"]
    }
  }
}
