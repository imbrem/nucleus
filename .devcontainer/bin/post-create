#!/usr/bin/env bash

set -euo pipefail

sudo chown -R vscode:vscode \
  node_modules \
  apps/docs/node_modules \
  packages/nucleus/node_modules \
  .pnpm-store \
  buck-out \
  .direnv \
  target \
  tools/glu/target

chmod +x .devcontainer/bin/glu

if [[ "${NUCLEUS_GITHUB_ACTIONS:-}" == "true" ]]; then
  # GitHub-hosted runners have limited memory and disk. Keep the nested Nix
  # daemon's peak resource usage low while allowing individual builds to use
  # both runner cores.
  export NIX_CONFIG="${NIX_CONFIG:-}
max-jobs = 1
cores = 2"
fi

if ! CI=true nix develop "path:$PWD" --command pnpm install --frozen-lockfile; then
  if [[ "${NUCLEUS_GITHUB_ACTIONS:-}" != "true" ]] ||
    nix store ping >/dev/null 2>&1; then
    exit 1
  fi

  # The nested daemon can be killed under transient runner resource pressure.
  # Preserve the partially populated store, restart it, and retry once.
  sudo /usr/local/share/nix-entrypoint.sh
  CI=true nix develop "path:$PWD" --command pnpm install --frozen-lockfile
fi
glu doctor
