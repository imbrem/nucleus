{
  "name": "@nucleus/nucleus",
  "version": "0.0.0",
  "private": true,
  "license": "CC0-1.0",
  "type": "module",
  "files": [
    "dist",
    "generated",
    "repl.html"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": "./generated/nucleus_bg.wasm"
  },
  "scripts": {
    "generate": "cargo build --locked -p covalence-nucleus --target wasm32-unknown-unknown && wasm-bindgen ../../target/wasm32-unknown-unknown/debug/covalence_nucleus.wasm --out-dir generated --out-name nucleus --target web",
    "build": "pnpm run generate && tsc",
    "check": "tsc --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "devDependencies": {
    "playwright-core": "1.61.1",
    "typescript": "5.9.2"
  }
}
