package nucleus:proof@0.1.0;

/// Low-level host objects and checked Ethane operations available to proofs.
interface host {
    /// Positive local row or negative immutable builtin; zero is invalid.
    type term-ref = s32;

    /// A syntactic relation in the Ethane conversion hierarchy.
    enum syn-rel {
        syn,
        alpha,
        conv,
    }

    /// The syntactic category of a checked arena row.
    enum sort {
        kind,
        ty,
        tm,
    }

    /// The axiom of infinity: some type carries an equality-reflecting endomap
    /// that misses a point.
    record infinity-axiom {
        /// The sentence the theorem concludes.
        exists-type: term-ref,
        /// The body `exists-type` quantifies, with the carrier type variable
        /// free.
        body: term-ref,
        /// The name of the carrier type variable bound in `body`.
        carrier-name: u64,
        /// The first name reserved for the sentence's own binders.
        base-name: u64,
        /// Slot of the premise-free sequent concluding `exists-type`.
        theorem: u64,
    }

    /// The guarded subtype-package sentence, and what an untrusted layer needs
    /// in order to build terms about the same subtype.
    record subtype-axiom {
        /// The carrier type the subtype was carved out of.
        carrier: term-ref,
        /// The defining predicate, of type `carrier -> bool`.
        predicate: term-ref,
        /// The sentence the theorem concludes. The only field carrying
        /// authority.
        exists-type: term-ref,
        /// The body `exists-type` quantifies, with the model type variable
        /// free. The subtype itself is `model(model-name, package-body)`.
        package-body: term-ref,
        /// The name of the model type variable bound in `package`.
        model-name: u64,
        /// The first name reserved for the package's own binders; the caller's
        /// terms use no name at or above it.
        base-name: u64,
        /// Slot of the premise-free sequent concluding `exists-type`.
        ///
        /// Opaque until the checked theorem operations are exposed here; it is
        /// returned rather than dropped so that exposing them later is not a
        /// breaking change.
        theorem: u64,
    }

    /// Result of HOL's standard `AP_THM` rule.
    record ap-thm {
        left: term-ref,
        right: term-ref,
        equality: term-ref,
        theorem: u64,
    }

    /// Result of HOL equality reflexivity.
    record refl-thm {
        equality: term-ref,
        theorem: u64,
    }

    /// Result of universal introduction.
    record forall-thm {
        universal: term-ref,
        theorem: u64,
    }

    /// Result of Hilbert-choice introduction.
    record choice-thm {
        witness: term-ref,
        proposition: term-ref,
        theorem: u64,
    }

    /// An immutable shared byte buffer.
    resource bytes {
        /// Copies component bytes into a host buffer.
        constructor(value: list<u8>);

        /// Number of bytes in the buffer.
        len: func() -> u64;

        /// Copies the complete buffer into component memory.
        to-list: func() -> list<u8>;

        /// Shares a subrange without copying its contents.
        slice: func(start: u64, end: u64) -> result<bytes, string>;

        /// Hashes the complete buffer and introduces a checked blob.
        blob: func() -> blob;
    }

    /// A checked content-addressed blob: an LCF fact `(address, bytes)`.
    resource blob {
        /// Checks a claimed 32-byte address against the complete buffer.
        check: static func(address: list<u8>, value: borrow<bytes>) -> result<blob, string>;

        /// The checked 32-byte address.
        address: func() -> list<u8>;

        /// Forgets checkedness and shares the underlying immutable bytes.
        bytes: func() -> bytes;

        /// Number of bytes in the checked blob.
        len: func() -> u64;
    }

    /// A private insertion-ordered CAS with stable zero-based object IDs.
    resource index-cas {
        constructor();

        /// Inserts a checked blob and returns its stable object ID.
        insert: func(value: borrow<blob>) -> u64;

        /// Hashes and inserts bytes, returning their stable object ID.
        put: func(value: borrow<bytes>) -> u64;

        /// Looks up a checked blob by object ID.
        get: func(object: u64) -> option<blob>;

        /// Finds the object ID for a checked address.
        find: func(address: list<u8>) -> result<option<u64>, string>;

        /// Removes an address without renumbering other objects.
        remove: func(address: list<u8>) -> result<bool, string>;

        /// Number of resident objects.
        len: func() -> u64;
    }

    /// Inserts a checked blob into the proof's default CAS.
    cas-insert: func(value: borrow<blob>) -> u64;

    /// Hashes and inserts bytes into the proof's default CAS.
    cas-put: func(value: borrow<bytes>) -> u64;

    /// Looks up a checked blob in the proof's default CAS by object ID.
    cas-get: func(object: u64) -> option<blob>;

    /// Finds an object in the proof's default CAS by checked address.
    cas-find: func(address: list<u8>) -> result<option<u64>, string>;

    /// Fetches untrusted bytes from the proof's default CAS.
    ///
    /// The result is deliberately not a checked fact: callers may use it when
    /// a later operation independently validates its output.
    cas-get-bytes: async func(address: list<u8>) -> result<option<bytes>, string>;

    /// Fetches a checked whole-blob fact from the proof's default CAS.
    ///
    /// The host checks that any optimized cached fact answers the exact
    /// requested address. The default implementation fetches and hashes all
    /// bytes before introducing the fact.
    cas-get-fact: async func(address: list<u8>) -> result<option<blob>, string>;

    /// A raw, unvalidated Ethane syntax arena.
    resource arena {
        constructor();

        /// Decodes one complete CBOR arena object.
        from-cbor: static func(value: borrow<bytes>) -> result<arena, string>;

        /// Encodes the arena through its CBOR wire representation.
        to-cbor: func() -> result<bytes, string>;

        /// Hashes the CBOR encoding produced by `to-cbor`.
        address: func() -> list<u8>;

        /// Number of local definition rows.
        len: func() -> u64;

        /// Constructs raw syntax. Positive references address local rows;
        /// negative references identify immutable builtins.
        kind-star: func() -> result<term-ref, string>;
        kind-arr: func(domain: term-ref, codomain: term-ref) -> result<term-ref, string>;
        bool-type: func() -> result<term-ref, string>;
        ty-arr: func(domain: term-ref, codomain: term-ref) -> result<term-ref, string>;
        ty-app: func(function: term-ref, argument: term-ref) -> result<term-ref, string>;
        ty-lam: func(binder: term-ref, body: term-ref) -> result<term-ref, string>;
        ty-fv: func(name: u64, kind: term-ref) -> result<term-ref, string>;
        ty-exists: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        ty-forall: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        model: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        tm-fv: func(name: u64, ty: term-ref) -> result<term-ref, string>;
        app: func(function: term-ref, argument: term-ref) -> result<term-ref, string>;
        lam: func(binder: term-ref, body: term-ref) -> result<term-ref, string>;
        bool-lit: func(value: bool) -> result<term-ref, string>;
        tm-eq: func(left: term-ref, right: term-ref) -> result<term-ref, string>;
        eps: func(ty: term-ref, predicate: term-ref) -> result<term-ref, string>;
        kind-ref: func(source: u64, foreign: term-ref) -> result<term-ref, string>;
        ty-ref: func(source: u64, foreign: term-ref) -> result<term-ref, string>;
        tm-ref: func(source: u64, foreign: term-ref) -> result<term-ref, string>;

        /// Appends raw arena metadata and imports.
        import-null: func() -> result<u64, string>;
        import-arena: func(value: borrow<arena>) -> result<u64, string>;
        import-link: func(address: list<u8>) -> result<u64, string>;
        add-context: func(proposition: term-ref) -> result<_, string>;
        add-axiom: func(name: string);
    }

    /// An immutable arena paired with the address of bytes that decode to it.
    resource table {
        /// Encodes and hashes a raw arena.
        from-arena: static func(value: borrow<arena>) -> result<table, string>;

        /// Decodes an arena from a checked blob.
        from-blob: static func(value: borrow<blob>) -> result<table, string>;

        /// The address of the bytes that introduced this table.
        address: func() -> list<u8>;

        /// Returns a mutable raw copy of the table's arena.
        arena: func() -> arena;
    }

    /// A checked Ethane arena. Row references and fact slots are integers.
    resource kernel {
        constructor();

        /// Returns a raw snapshot of the checked arena.
        arena: func() -> arena;

        /// Hashes the kernel's complete arena encoding.
        address: func() -> list<u8>;

        /// Number of checked local rows.
        len: func() -> u64;

        /// Checked row inspection.
        category: func(reference: term-ref) -> result<sort, string>;
        classifier: func(reference: term-ref) -> result<term-ref, string>;
        find: func(reference: term-ref) -> result<term-ref, string>;
        find-mut: func(reference: term-ref) -> result<term-ref, string>;
        equivalent: func(left: term-ref, right: term-ref) -> result<bool, string>;
        equivalent-mut: func(left: term-ref, right: term-ref) -> result<bool, string>;

        /// Checked syntax constructors.
        kind-star: func() -> result<term-ref, string>;
        kind-arr: func(domain: term-ref, codomain: term-ref) -> result<term-ref, string>;
        bool-type: func(star: term-ref) -> result<term-ref, string>;
        ty-arr: func(domain: term-ref, codomain: term-ref) -> result<term-ref, string>;
        ty-app: func(function: term-ref, argument: term-ref) -> result<term-ref, string>;
        ty-lam: func(binder: term-ref, body: term-ref) -> result<term-ref, string>;
        ty-fv: func(name: u64, kind: term-ref) -> result<term-ref, string>;
        ty-exists: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        ty-forall: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        model: func(name: u64, predicate: term-ref) -> result<term-ref, string>;
        tm-fv: func(name: u64, ty: term-ref) -> result<term-ref, string>;
        app: func(function: term-ref, argument: term-ref) -> result<term-ref, string>;
        lam: func(binder: term-ref, body: term-ref) -> result<term-ref, string>;
        bool-lit: func(bool-type: term-ref, value: bool) -> result<term-ref, string>;
        tm-eq: func(bool-type: term-ref, left: term-ref, right: term-ref) -> result<term-ref, string>;
        eps: func(ty: term-ref, predicate: term-ref) -> result<term-ref, string>;

        /// Derived logical constructions.
        ///
        /// Macros over the primitives above, not new row shapes: negation is
        /// equality with `false`, universal quantification is equality with the
        /// constantly-true function, existential quantification is Hilbert
        /// choice, and conjunction is the equality-only encoding
        /// `(\f. f l r) = (\f. f true true)`. The binder of a conjunction is a
        /// `tm-fv` row of type `bool -> bool -> bool`, and the caller owns the
        /// choice of a name that does not capture.
        ///
        /// These explicit HOL definitions also determine the fixed Boolean
        /// builtin unfolding rule. Userspace init names do not select meanings.
        not-tm: func(bool-type: term-ref, proposition: term-ref) -> result<term-ref, string>;
        forall-tm: func(bool-type: term-ref, binder: term-ref, body: term-ref) -> result<term-ref, string>;
        exists-tm: func(binder: term-ref, body: term-ref) -> result<term-ref, string>;
        and-tm: func(bool-type: term-ref, binder: term-ref, left: term-ref, right: term-ref) -> result<term-ref, string>;
        or-tm: func(bool-type: term-ref, binder: term-ref, left: term-ref, right: term-ref) -> result<term-ref, string>;
        imp-tm: func(bool-type: term-ref, binder: term-ref, left: term-ref, right: term-ref) -> result<term-ref, string>;

        /// One past the largest name reachable from `roots`, counting "no
        /// names at all" as zero.
        ///
        /// A binder allocated here cannot capture anything in `roots`. Exposed
        /// because a component building terms about a subtype has to pick the
        /// same names the axiom did.
        fresh-name: func(roots: list<term-ref>) -> result<u64, string>;

        /// Concludes that a chosen model satisfies the predicate that chose it:
        /// from a theorem concluding `exists-type a. P`, derives `P` with `a`
        /// replaced by `model a. P`.
        ///
        /// The type-level analogue of `eps`'s specification. The kernel does
        /// not substitute — the caller builds the substituted term and a `conv`
        /// or finer fact relating the predicate to it, exactly as `ty-beta`
        /// expects, and this checks that the fact's endpoints are the ones the
        /// theorem licenses.
        ///
        /// The theorem must be a premise-free sequent with a single positive
        /// conclusion, which is the shape the axiom rules produce.
        model-spec: func(theorem: u64, substitution: u64) -> result<u64, string>;

        /// From `G |- f = g`, derive `G |- f argument = g argument`.
        /// Introduces the exact theorem `|- term = term`.
        refl: func(bool-ty: term-ref, term: term-ref) -> result<refl-thm, string>;

        ap-thm: func(theorem: u64, argument: term-ref) -> result<ap-thm, string>;

        /// From `G |- x = y`, derive `G |- function x = function y`.
        ap-term: func(theorem: u64, function: term-ref) -> result<ap-thm, string>;

        /// From `G |- p = q` and `D |- p`, derive `G, D |- q`.
        eq-mp: func(equality: u64, premise: u64) -> result<u64, string>;

        /// Generalize a theorem over a variable absent from its premises.
        forall-intro: func(theorem: u64, binder: term-ref) -> result<forall-thm, string>;

        /// Generalize into an existing equality-encoded universal.
        forall-intro-at: func(theorem: u64, binder: term-ref, universal: term-ref) -> result<u64, string>;

        /// Replace a proved witness by the Hilbert-selected witness.
        choice-intro: func(theorem: u64) -> result<choice-thm, string>;

        /// Introduce choice into an existing matching target.
        choice-intro-at: func(theorem: u64, target: term-ref) -> result<u64, string>;

        /// Rewrite every occurrence of one semantically equal theorem atom.
        convert-theorem: func(theorem: u64, source: term-ref, target: term-ref) -> result<_, string>;

        /// Rewrite one semantically equal atom only in conclusions.
        convert-conclusions: func(theorem: u64, source: term-ref, target: term-ref) -> result<_, string>;

        /// Contract duplicate rows and literals in a theorem.
        contract-theorem: func(theorem: u64) -> result<_, string>;

        /// From `G |- p = true`, derive `G |- p`.
        eqt-elim: func(theorem: u64) -> result<u64, string>;

        /// Concludes the axiom of infinity, consuming the `ax.inf` capability.
        ///
        /// The sentence is closed, so it takes only the Boolean type to build
        /// it at. `model-spec` can then name and specify the carrier selected
        /// by this existential.
        inf-exists: func(bool-type: term-ref) -> result<infinity-axiom, string>;

        /// Concludes the guarded subtype-package sentence for `carrier` and
        /// `predicate`, consuming the `ax.sub` capability.
        ///
        /// The subtype carved out is
        /// `{ x : carrier // P x or not exists y. P y }`, so this is total:
        /// every predicate has a package and no nonemptiness proof is needed.
        ///
        /// Fails unless `add-axiom("ax.sub")` has been called, so an arena that
        /// rests on the subtype axiom always says so. The sentence is built
        /// here rather than taken from the caller, and the sequent minted for
        /// it is premise-free.
        ///
        /// This is the whole of the trusted surface. Building a usable subtype
        /// from the result — the subtype itself, `rep`, `abs`, the laws — is
        /// ordinary construction over the constructors above and carries no
        /// authority.
        sub-exists: func(bool-type: term-ref, carrier: term-ref, predicate: term-ref)
            -> result<subtype-axiom, string>;

        /// Checked imports, contexts, and axiom capabilities.
        import-arena: func(value: borrow<arena>) -> result<u64, string>;
        import-table: func(value: borrow<table>) -> result<u64, string>;
        import-link: func(address: list<u8>) -> result<u64, string>;
        kind-ref: func(source: u64, foreign: term-ref) -> result<term-ref, string>;
        ty-ref: func(source: u64, foreign: term-ref, kind: term-ref) -> result<term-ref, string>;
        tm-ref: func(source: u64, foreign: term-ref, ty: term-ref) -> result<term-ref, string>;
        add-context: func(proposition: term-ref) -> result<_, string>;
        add-axiom: func(name: string) -> result<_, string>;

        /// Syntactic-fact cache operations. Slots are one-based integers.
        syn-fact-count: func() -> u64;
        remove-syn-fact: func(fact: u64) -> bool;
        truncate-syn-facts: func(len: u64) -> result<_, string>;
        syn-refl: func(relation: syn-rel, input: term-ref, target: option<u64>) -> result<u64, string>;
        syn-refine: func(fact: u64, relation: syn-rel, target: option<u64>) -> result<u64, string>;
        syn-symm: func(fact: u64, target: option<u64>) -> result<u64, string>;
        syn-trans: func(left: u64, right: u64, target: option<u64>) -> result<u64, string>;
        syn-sub-var: func(var: term-ref, val: term-ref, target: option<u64>) -> result<u64, string>;
        syn-sub-leaf: func(var: term-ref, val: term-ref, input: term-ref, target: option<u64>) -> result<u64, string>;
        syn-sub-leaf-forall: func(var: term-ref, input: term-ref, target: option<u64>) -> result<u64, string>;
        syn-sub-identity: func(
            var: term-ref,
            val: term-ref,
            input: term-ref,
            output: term-ref,
            variable-equality: u64,
            body-equality: u64,
            target: option<u64>,
        ) -> result<u64, string>;
        syn-congr: func(
            relation: syn-rel,
            var: option<term-ref>,
            val: option<term-ref>,
            input: term-ref,
            output: term-ref,
            children: list<u64>,
            target: option<u64>,
        ) -> result<u64, string>;
        syn-binder-congr: func(
            relation: syn-rel,
            var: option<term-ref>,
            val: option<term-ref>,
            input: term-ref,
            output: term-ref,
            binder: u64,
            body: u64,
            target: option<u64>,
        ) -> result<u64, string>;
        syn-implicit-binder-congr: func(
            relation: syn-rel,
            var: option<term-ref>,
            val: option<term-ref>,
            input: term-ref,
            output: term-ref,
            binder: term-ref,
            body: u64,
            target: option<u64>,
        ) -> result<u64, string>;
        syn-alpha-binder: func(
            input: term-ref,
            output: term-ref,
            binder-classifier: u64,
            body-substitution: u64,
            target: option<u64>,
        ) -> result<u64, string>;
        syn-alpha-implicit-binder: func(
            input: term-ref,
            output: term-ref,
            input-binder: term-ref,
            output-binder: term-ref,
            body-substitution: u64,
            target: option<u64>,
        ) -> result<u64, string>;
        tm-beta: func(source: term-ref, substitution: u64, target: option<u64>) -> result<u64, string>;
        ty-beta: func(source: term-ref, substitution: u64, target: option<u64>) -> result<u64, string>;
        tm-eta: func(source: term-ref, target: option<u64>) -> result<u64, string>;
        union-syn-fact: func(fact: u64) -> result<_, string>;
    }
}

/// Default non-authoritative capabilities available to proof components.
interface capabilities {
    use host.{bytes};

    /// Returns bytes from the loader's cryptographically secure random source.
    /// Test and replay profiles may substitute a deterministic seeded source.
    random-bytes: func(len: u64) -> result<bytes, string>;
}

/// Versioned userspace conveniences built exclusively from checked host calls.
///
/// These operations are accelerators, not additional proof authority: every
/// returned theorem is introduced by the same kernel rules as the low-level
/// `host` interface.
interface tactics {
    use host.{bytes, kernel, term-ref};

    enum rewrite-direction {
        forward,
        backward,
    }

    record rewrite-result {
        source: term-ref,
        target: term-ref,
        theorem: u64,
    }

    /// Applies a checked endomap `count` times to a checked base value.
    ///
    /// This is generic syntax acceleration, not a canonical natural numeral:
    /// the caller supplies the base and function and owns their meaning.
    iterate-unary: func(
        kernel: borrow<kernel>,
        zero: term-ref,
        successor: term-ref,
        count: u64,
    ) -> result<term-ref, string>;

    /// Rewrites a proposition using a proved equality and `EQ_MP`.
    rewrite-proposition: func(
        kernel: borrow<kernel>,
        bool-type: term-ref,
        equality: u64,
        premise: u64,
        direction: rewrite-direction,
    ) -> result<rewrite-result, string>;
}

/// The minimal interface for a reusable kernel-transforming strategy.
interface strategy {
    use host.{kernel};

    /// Applies a compact strategy-local tactic to a supplied or fresh kernel.
    ///
    /// The strategy interprets `tactic-id`; it carries no ambient authority.
    /// Ownership of a supplied kernel crosses the component boundary. `none`
    /// asks the strategy to choose a checked starting kernel.
    apply-tactic: async func(
        tactic-id: u64,
        arguments: list<u8>,
        kernel: option<kernel>,
    ) -> result<kernel, string>;
}

/// A portable kernel-transforming strategy.
world proof {
    import host;
    import capabilities;
    import tactics;
    export strategy;
}

/// A portable implementation of the complete proof host interface.
world kernel-host {
    export host;
    export tactics;
}
