if has nix && has use_flake; then
  use flake
else
  mkdir -p .direnv/bin
  # Close fd 3, which direnv reads the environment from: Buck's daemon and
  # forkserver outlive the build and would keep it open, hanging direnv.
  {
    if has buck2; then
      buck2 build //tools/glu:glu --show-full-simple-output |
        xargs ln -sf -t .direnv/bin
    else
      cargo build --quiet --locked --manifest-path tools/glu/Cargo.toml
      ln -sf "$PWD/tools/glu/target/debug/glu" .direnv/bin/glu
    fi
  } 3>&-
  PATH_add .direnv/bin
fi
